# Terraform state and backup files
*.tfstate
*.tfstate.backup
*.tfstate.*
backend.tf

# Terraform cache & lock file
.terraform.lock.hcl

# Terraform sensitive variable files
terraform.tfvars
*.auto.tfvars
*.tfplan                   # Terraform plan output files

# Ignore user-specific config files
.terraformrc
terraform.rc

# Private keys and secrets
*.pem
*.key
id_rsa*
id_ecdsa*
id_ed25519*
credentials.json
secrets/

# Logs and crash/debug output
*.log
crash.log

# OS-generated files
.DS_Store                  # macOS Finder metadata

# Editor-specific files
.vscode/                   # VS Code settings
*.code-workspace